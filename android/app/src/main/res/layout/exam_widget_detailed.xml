<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp"
    android:background="@android:drawable/dialog_holo_light_frame">
    <TextView android:id="@+id/exam_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Upcoming exam" android:textStyle="bold" android:textSize="16sp" android:maxLines="1" android:ellipsize="end" android:textColor="#171A3B"/>
    <TextView android:id="@+id/exam_days" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="12 days left" android:textSize="13sp" android:paddingTop="2dp"/>
    <ProgressBar android:id="@+id/exam_progress" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="7dp" android:max="100"/>
    <TextView android:id="@+id/exam_progress_label" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="0 / 0 topics prepared" android:textSize="11sp" android:paddingTop="3dp" android:paddingBottom="5dp"/>
    <TextView android:id="@+id/subject_0" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Subject 1" android:textSize="12sp" android:maxLines="1"/>
    <ProgressBar android:id="@+id/subject_progress_0" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:max="100"/>
    <TextView android:id="@+id/subject_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Subject 2" android:textSize="12sp" android:maxLines="1" android:paddingTop="4dp"/>
    <ProgressBar android:id="@+id/subject_progress_1" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:max="100"/>
    <TextView android:id="@+id/subject_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Subject 3" android:textSize="12sp" android:maxLines="1" android:paddingTop="4dp"/>
    <ProgressBar android:id="@+id/subject_progress_2" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:max="100"/>
</LinearLayout>